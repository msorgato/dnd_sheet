# Copy this file to .env and fill in your Firebase project values.
# Find these in: Firebase Console → Project Settings → Your Apps → Web App → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Imposta a "true" per usare gli emulatori Firebase locali (Auth + Firestore)
# invece di un progetto reale — utile per sviluppo/test senza credenziali.
# Con gli emulatori attivi, i valori VITE_FIREBASE_* sopra possono restare
# segnaposto (bastano stringhe non vuote): usa gli stessi valori dell'esempio
# in README → "Sviluppo locale con gli emulatori Firebase".
VITE_USE_FIREBASE_EMULATORS=false
