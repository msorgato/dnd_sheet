rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funzioni helper ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/profile).data.role == 'admin';
    }

    function isLobbyMember(lobbyId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid));
    }

    function isLobbyOwner(lobbyId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.ownerId == request.auth.uid;
    }

    function isLobbyGM(lobbyId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.get('gmUid', '') == request.auth.uid;
    }

    // Anti-flood chat: max 10 messaggi ogni 60s, contati su lobbies/{lobbyId}/members/{uid}.
    // Limite "debole": valida solo l'aritmetica di un aggiornamento onesto del contatore,
    // non può obbligare un client a includerlo — un client modificato può ometterlo.
    function messageRateLimitOk(lobbyId, uid) {
      let m = get(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(uid)).data;
      return !('msgWindowStart' in m)
        || request.time > m.msgWindowStart + duration.value(60, 's')
        || m.msgCount < 10;
    }

    function isValidThrottleCounterUpdate() {
      let windowExpired = !('msgWindowStart' in resource.data)
        || request.time > resource.data.msgWindowStart + duration.value(60, 's');
      return windowExpired
        ? (request.resource.data.msgCount == 1 && request.resource.data.msgWindowStart == request.time)
        : (request.resource.data.msgCount == resource.data.msgCount + 1
            && request.resource.data.msgWindowStart == resource.data.msgWindowStart);
    }

    // ── Dati utente (personaggi, impostazioni, bozze classi custom) ──────────
    // Ogni utente può leggere e scrivere solo i propri dati.
    // Copre anche users/{uid}/customClasses/{classId} (bozze classi custom admin).

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Libreria condivisa (talenti, incantesimi, classi pubblicate) ─────────
    // Lettura pubblica (incluso library/classes/entries); scrittura solo admin.
    // Copre: library/feats/entries, library/spells/entries, library/classes/entries

    match /library/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Audit log ─────────────────────────────────────────────────────────────
    // Solo admin può leggere. Scrittura diretta dal client (niente Cloud Functions):
    // solo create (mai update/delete), performedBy deve coincidere con l'autore della
    // richiesta, e timestamp deve essere il timestamp del server (impedisce di falsificare
    // la data). Azioni di libreria: solo admin. Auto-cancellazione account: chiunque, ma
    // solo con se stesso come target.

    match /audit_log/{entryId} {
      allow read: if isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.keys().hasOnly(['action', 'performedBy', 'targetId', 'targetCollection', 'timestamp'])
        && (
          (isAdmin()
            && request.resource.data.action in ['library.created', 'library.updated', 'library.deleted'])
          || (request.resource.data.action == 'account.deleted'
              && request.resource.data.targetId == request.auth.uid)
        );

      allow update, delete: if false;
    }

    // ── Lobby ─────────────────────────────────────────────────────────────────

    match /lobbies/{lobbyId} {
      // getDoc richiede membership; list (query per codice di adesione) richiede solo autenticazione.
      allow get: if isLobbyMember(lobbyId);
      allow list: if isAuthenticated();

      // Solo utenti autenticati possono creare lobby, e devono essere l'owner.
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;

      // L'owner può modificare la lobby (es. chiuderla); il GM può aggiornare solo gmUid.
      allow update: if isLobbyOwner(lobbyId)
        || (isLobbyGM(lobbyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gmUid']));

      // Nessuno può eliminare documenti di lobby.
      allow delete: if false;

      // ── Membri ─────────────────────────────────────────────────────────────

      match /members/{memberId} {
        allow read: if isAuthenticated()
          && (memberId == request.auth.uid || isLobbyMember(lobbyId));

        allow create: if isAuthenticated()
          && memberId == request.auth.uid
          && request.resource.data.displayName.size() <= 40;

        allow update: if isAuthenticated()
          && memberId == request.auth.uid
          && request.resource.data.displayName.size() <= 40
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['msgCount', 'msgWindowStart'])
              || isValidThrottleCounterUpdate());

        allow delete: if isAuthenticated()
          && (memberId == request.auth.uid || isLobbyOwner(lobbyId));
      }

      // ── Messaggi ───────────────────────────────────────────────────────────

      match /messages/{messageId} {
        allow read: if isLobbyMember(lobbyId);

        allow create: if isLobbyMember(lobbyId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'content', 'sentAt'])
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.isActive == true
          && messageRateLimitOk(lobbyId, request.auth.uid)
          && (!('hidden' in request.resource.data)
              || request.resource.data.hidden == false
              || isLobbyGM(lobbyId));

        allow update, delete: if false;
      }
    }
  }
}
